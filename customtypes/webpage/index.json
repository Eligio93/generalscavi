{
  "format": "page",
  "id": "webpage",
  "label": "WebPage",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "slug": {
        "type": "Text",
        "config": {
          "label": "slug",
          "placeholder": ""
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "contacts_banner": {
              "type": "SharedSlice"
            },
            "all_services": {
              "type": "SharedSlice"
            },
            "stepper": {
              "type": "SharedSlice"
            },
            "projects": {
              "type": "SharedSlice"
            },
            "service_banner": {
              "type": "SharedSlice"
            },
            "important_projects": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "banner_cta": {
              "type": "SharedSlice"
            },
            "certifications_banner": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
